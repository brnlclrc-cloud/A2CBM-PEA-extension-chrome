{
  "manifest_version": 3,
  "name": "PEA Pro - Sync Assurance Vie BNP",
  "version": "1.1.3",
  "description": "Synchronisation automatique en 1 clic de votre Assurance Vie BNP Paribas vers PEA Pro.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Synchroniser Assurance Vie BNP avec PEA Pro",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
